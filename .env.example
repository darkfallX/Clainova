MODE=rehearsal
PORT=4173
# Testnet mode requires all entries below except optional sponsor and sender ID.
# PUBLIC_ORIGIN is the public HTTPS origin of this single Node instance.
PUBLIC_ORIGIN=
DATA_DIR=.data
DATA_KEY=
VERIFIER_SEED=
OPERATOR_PASSWORD=
ESCROW_ADDRESS=
AT_USERNAME=sandbox
AT_API_KEY=
AT_FROM=
RPC_URL=https://evm-testnet.qore.host
SPONSOR_PRIVATE_KEY=
# Deployment only. Use a dedicated Diana account with an open deployment window.
DEPLOYER_PRIVATE_KEY=


# team or field. Team measurements are the default.
COHORT=team
