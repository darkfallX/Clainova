MODE=rehearsal
PORT=4173
# Testnet mode requires all entries below except optional sponsor and sender ID.
# PUBLIC_ORIGIN is the public HTTPS origin of this single Node instance.
PUBLIC_ORIGIN=
DATA_DIR=.data
DATA_KEY=
VERIFIER_SEED=
OPERATOR_PASSWORD=
ESCROW_ADDRESS=
# Shown to recipients at the start of the invitation, up to 40 characters.
ORGANISER_NAME=
# africastalking sends SMS. android sends a real SMS from your own Android phone
# for free (your SIM's normal rate) through SMS Gateway for Android. outbox writes
# messages to a private file for team runs.
SMS_PROVIDER=africastalking
AT_USERNAME=sandbox
AT_API_KEY=
AT_FROM=
# For SMS_PROVIDER=android: install the app from
# github.com/capcom6/android-sms-gateway/releases, turn on its Cloud server and
# copy the username and password it shows. Keep them only in this file.
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
# Optional. Defaults to the free cloud relay. A phone on your Wi-Fi: http://<phone-ip>:8080/message
SMSGATE_URL=
# For SMS_PROVIDER=traccar: install Traccar SMS Gateway from Google Play
# (org.traccar.gateway) and copy the cloud token it shows. Keep it only here.
TRACCAR_SMS_TOKEN=
# Optional. Defaults to https://www.traccar.org/sms/. On your Wi-Fi, use the address and key the app shows.
TRACCAR_SMS_URL=
RPC_URL=https://evm-testnet.qore.host
# Recovery phrase of a dedicated, funded Diana test account that pays recipients' gas.
SPONSOR_MNEMONIC=
# Deployment only. Use a dedicated Diana account with an open deployment window.
DEPLOYER_PRIVATE_KEY=


# Which proxy to believe about a visitor's address, for rate limits. cloudflare
# for a Cloudflare tunnel to loopback, fly for Fly.io, forwarded for any other
# host whose proxy appends to X-Forwarded-For. Leave empty without a proxy.
TRUST_PROXY=

# "on" opens /try, where anyone can collect a small pre-funded payment whose code
# is shown on the page. Fund the pool with scripts/fund-demo.mjs.
DEMO_PAYMENTS=

# team or field. Team measurements are the default.
COHORT=team
