{
  "name": "clainova",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/start.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs && hardhat test --no-compile",
    "test:browser": "node tests/browser.mjs",
    "coverage": "hardhat coverage",
    "deploy:testnet": "node --env-file-if-exists=.env scripts/deploy.mjs"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.2.8",
    "@qorechain/pqc": "0.2.3",
    "@qorechain/qoreseal": "0.1.0",
    "@qorechain/qoresign": "0.2.0",
    "@qorechain/qorex-types": "0.1.0",
    "@qorechain/wallet-adapter": "0.6.0",
    "africastalking": "^0.7.0",
    "cosmjs-types": "0.9.0",
    "ethers": "^6.16.0"
  },
  "devDependencies": {
    "axe-core": "4.10.3",
    "esbuild": "^0.25.0",
    "hardhat": "2.26.5",
    "playwright": "^1.55.0",
    "solc": "0.8.28",
    "solidity-coverage": "0.8.17"
  }
}
